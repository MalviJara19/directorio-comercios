{
  "expo": {
    "name": "directorio-comercios",
    "slug": "directorio-comercios",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "directoriocomercios",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Necesitamos acceder a tus fotos para que puedas agregarlas a tu comercio.",
          "cameraPermission": "Necesitamos acceder a la cámara para que puedas tomar fotos y grabar videos.",
          "microphonePermission": "Necesitamos acceder al micrófono para grabar videos con sonido."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "La aplicación necesita acceder a la cámara para escanear códigos QR."
        }
      ],
      "expo-image",
      "expo-web-browser",
      "expo-video",
      "expo-secure-store",
      "expo-font",
      "expo-status-bar",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "a23f6594-4893-4e8f-83a5-e0b72053c2cd"
      }
    }
  }
}
